  "planRaw": [
   {
    "day": 0,
    "k": "ada",
    "ans": "She would wash and mend Bert's shirts and socks on Monday, iron them on Tuesday, and see to the coal on Wednesday. Thursday, being a free day, she would clean the rooms.",
    "items": 0
   },
   {
    "day": 0,
    "k": "ada",
    "ans": "On Monday she would wash up the breakfast things, and clean Bert's boots; Tuesday she would iron; Wednesday she would mend linen; Thursday she would clean the knives and forks; Friday she would go out and pay the rent; Saturday she would sort the clean linen.",
    "items": 1
   },
   {
    "day": 0,
    "k": "arthur",
    "ans": "On Monday he would pay the household bills, make out the list of provisions for the week, and see the baby.",
    "items": 1
   },
   {
    "day": 0,
    "k": "thomas",
    "ans": "",
    "items": 0
   },
   {
    "day": 0,
    "k": "thomas",
    "ans": "",
    "items": 0
   },
   {
    "day": 2,
    "k": "ada",
    "ans": "",
    "items": 0
   },
   {
    "day": 2,
    "k": "ada",
    "ans": "On Monday she went to see Mr. Hale about redeeming her husband's watch, and to arrange to pay up past arrears of rent; on Tuesday she saw Mr. Gedge; on Wednesday she saw the doctor about Mary, who has a cold; on Thursday she cleaned more offices; on Friday she drew her wages, and paid rent and redeemd husband's watch; on Saturday she did odd jobs.",
    "items": 5
   },
   {
    "day": 2,
    "k": "arthur",
    "ans": "On Monday he paid the bills and saw the baby; on Tuesday he went to the City and called on his mother; on Wednesday he arranged his shelves; on Thursday he did the housekeeping; on Friday he reckoned up the week's expenses; and on Saturday he went to church.",
    "items": 5
   },
   {
    "day": 2,
    "k": "thomas",
    "ans": "On Monday he should go out and pay his premiums; Tuesday he should call on his brother; Wednesday he should arrange to visit his sister; Thursday he should see to the safety of his money; Friday he should order coal; Saturday he should do odd jobs about the house, and on Sunday he should go to church.",
    "items": 2
   }
  ],
