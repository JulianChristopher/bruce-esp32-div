  "planRaw": [
   {
    "day": 0,
    "k": "ada",
    "ans": "She saw to: Monday, wash the steps and scrub the office-floors; Tuesday, clean windows; Wednesday, polish brasswork; Thursday, go to market; Friday, pay the rent; Saturday, mend Bert's socks; Sunday, read the religious papers.\n\nTuesday, 10 September, was fine, and she cleaned the windows.",
    "items": 0
   },
   {
    "day": 0,
    "k": "ada",
    "ans": "On Monday she would clean the offices, and the baby must be washed and dressed; on Tuesday she would wash and dress the baby, and Bert must have a clean shirt; on Wednesday she would mend Bert's socks and shirts, and turn his underclothing; on Thursday she must go to the pawnbroker's, and on Friday she must pay the rent and take the clean linen home from the wash.",
    "items": 4
   },
   {
    "day": 0,
    "k": "arthur",
    "ans": "On Monday he would post his letters, and collect the premiums for the week; on Tuesday he would balance the cash-book; on Wednesday he would pay the wages; on Thursday he would close the ledger; on Friday he would take the money to the chief cashier.",
    "items": 5
   },
   {
    "day": 0,
    "k": "thomas",
    "ans": "On Monday he would collect his rents; on Tuesday he would visit his brother at Lee; on Wednesday he would shave; on Thursday he would go to the dentist's; on Friday he would pay the household bills; and on Saturday he would clean his boots.",
    "items": 5
   },
   {
    "day": 0,
    "k": "ada",
    "ans": "She saw to:",
    "items": 0
   },
   {
    "day": 0,
    "k": "ada",
    "ans": "She thought: On Monday, she would see to getting coal into the house.",
    "items": 1
   },
   {
    "day": 0,
    "k": "arthur",
    "ans": "On Monday he posted his letters; and collected the premiums for the week; on Tuesday he balanced the cash-book; on Wednesday he sorted the inland correspondence; on Thursday he checked the outdoor staff; and on Friday he received the cheques from the country, and paid the wages.",
    "items": 5
   },
   {
    "day": 0,
    "k": "thomas",
    "ans": "On Monday he proposed to visit his brother at Lee, and to take the tram from High Street, Borough, to Blackheath; on Tuesday to buy himself a new pair of boots; on Wednesday to have his hair cut.",
    "items": 1
   }
  ],
