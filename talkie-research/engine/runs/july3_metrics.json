  "planRaw": [
   {
    "day": 0,
    "k": "ada",
    "ans": "On Tuesday morning she washed up the crockery, set the place to rights, and tidied Bert. On Wednesday morning she cleaned the boots and knives and forks, and went out to do shopping. On Thursday morning she darned socks, and looked over Bert's clothes. On Friday morning she washed the linen and did the family mending. On Saturday morning she made the beds, and swept and polished the rooms.",
    "items": 5
   },
   {
    "day": 0,
    "k": "arthur",
    "ans": "On Monday he would post his letters; on Tuesday he would go to the City and collect his rents; on Wednesday he would see about getting his life insured; on Thursday he would pay the premium and take the receipt; on Friday he would deposit the money in the savings bank; and on Saturday he would draw out money for household expenses.",
    "items": 5
   },
   {
    "day": 0,
    "k": "thomas",
    "ans": "On Tuesday he would see to the blinds; on Wednesday he would pay the milkman; on Thursday he would go to the doctor about his leg; and on Friday he would pay the charwoman.",
    "items": 4
   }
